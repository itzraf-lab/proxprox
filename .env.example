# Qillin environment configuration.
# Copy to `.env` (`cp .env.example .env`) and fill in the values.
# The Makefile targets source this file automatically.

# ── Required ────────────────────────────────────────────────────────────────
# Master key for the LiteLLM admin API. Any long random string; keep it secret.
LITELLM_MASTER_KEY=sk-change-me-please

# Initial admin account (seeded/updated on every API-server startup).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Signs user JWTs. Use at least 32 random characters; keep it secret.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# PostgreSQL connection for LiteLLM's virtual-key / spend tables.
# `make db-setup` provisions this exact role + database locally.
DATABASE_URL=postgresql://qillin:qillin@localhost:5432/qillin_litellm

# ── Optional ──────────────────────────────────────────────────────────────
# Admin display name (default: Eruu).
ADMIN_USERNAME=Admin

# Where the API server reaches LiteLLM (default: http://localhost:8000).
LITELLM_URL=http://localhost:8000

# Port LiteLLM listens on (default: 8000).
LITELLM_PORT=8000

# Where LiteLLM's usage callback POSTs (default: http://localhost:8080).
QILLIN_INTERNAL_URL=http://localhost:8080

# NOTE: do NOT set a global PORT here — the API server defaults to 8080 and the
# web dev server to 5173. Setting PORT would collide between the two services.
