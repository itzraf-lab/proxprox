modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LiteLLM Proxy"

[[workflows.workflow]]
name = "LiteLLM Proxy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python litellm-proxy/start.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_USERNAME = "Eruu"
LITELLM_DATABASE_URL = "sqlite:///./data/litellm.db"
LITELLM_PORT = "8000"
LITELLM_URL = "http://localhost:8000"
